# Copier en .env et adapter si besoin. Ce fichier n'est volontairement pas commité (voir .gitignore).

# Utilisée par le backend (kyc_api) et par le worker.
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/kyc

# Identifiant du worker dans worker_heartbeat.locked_by / worker_heartbeat.worker_id.
# Doit être unique par instance. Laisser vide (ou commenté) en local : le worker en dérive un
# automatiquement (pid du processus), ce qui garantit l'unicité même si vous lancez deux workers
# en parallèle sur la même machine. Ne fixer une valeur qu'en production, où l'orchestrateur
# garantit lui-même l'unicité de l'identifiant qu'il fournit.
WORKER_ID=

# Niveau de log commun aux deux processus : trace, debug, info, warn, error.
LOG_LEVEL=info

# Répertoire de cache des archives téléchargées par le worker. Laisser vide en production : le
# cache n'a de sens qu'en développement, pour ne pas retélécharger ~300 Mo à chaque itération
# (voir D1.18, docs/plans/phase-1.1-fix.md).
AN_CACHE_DIR=worker/.cache

# Authentification du back-office (D3.1, docs/plans/phase-3-categorisation.md). Une application
# OAuth GitHub même en local : le rappel sur http://localhost:8000 est autorisé par GitHub, et
# CLAUDE.md exclut tout contournement de développement.
ADMIN_GITHUB_CLIENT_ID=
ADMIN_GITHUB_CLIENT_SECRET=
# Logins GitHub autorisés à entrer dans le back-office, séparés par des virgules. Vide = personne
# n'entre.
ADMIN_GITHUB_LOGINS=
# Clé de signature des cookies de session. Ne PAS reprendre celle-ci en production.
SESSION_SECRET=changez-moi
PUBLIC_BASE_URL=http://localhost:8000
