# Copier en .env et adapter si besoin. Ce fichier n'est volontairement pas commité (voir .gitignore).

# Utilisée par le backend (kyc_api) et par le worker.
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/kyc

# Identifiant du worker dans worker_heartbeat.locked_by / worker_heartbeat.worker_id.
# Doit être unique par instance. Laisser vide (ou commenté) en local : le worker en dérive un
# automatiquement (pid du processus), ce qui garantit l'unicité même si vous lancez deux workers
# en parallèle sur la même machine. Ne fixer une valeur qu'en production, où l'orchestrateur
# garantit lui-même l'unicité de l'identifiant qu'il fournit.
WORKER_ID=

# Niveau de log commun aux deux processus : trace, debug, info, warn, error.
LOG_LEVEL=info

# Routes de démonstration de la boucle de jobs (POST /dev/jobs, non authentifiée). Faux par
# défaut côté backend : la laisser montée en production serait un déni de service trivial.
# À true en développement local.
ENABLE_DEV_ROUTES=true
