# Copier en .env et adapter si besoin. Ce fichier n'est volontairement pas commité (voir .gitignore).

# Utilisée par le backend (kyc_api) et par le worker.
DATABASE_URL=postgresql://kyc:kyc@localhost:5432/kyc

# Identifiant du worker dans worker_heartbeat.locked_by / worker_heartbeat.worker_id.
# Doit être unique par instance : nom d'hôte + pid en local, un identifiant fourni par
# l'environnement en production.
WORKER_ID=local-dev

# Niveau de log commun aux deux processus : trace, debug, info, warn, error.
LOG_LEVEL=info
