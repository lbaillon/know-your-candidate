  "query": "\n        SELECT p.id, p.an_uid, p.wikidata_qid, p.prenom, p.nom\n        FROM person p\n        LEFT JOIN person_slug s ON s.person_id = p.id AND s.is_current\n        WHERE s.person_id IS NULL\n        ORDER BY p.id\n        ",
