{% macro vote_item(vote) %}
<li class="vote-item">
  <a class="vote-item__titre" href="/scrutin/{{ vote.legislature }}/{{ vote.numero }}">{{ vote.titre }}</a>
  <p class="vote-item__meta">
    {{ vote.date_scrutin.strftime("%d/%m/%Y") }} —
    {{ vote_position_label(vote.position, vote.cause_non_vote) }}
    {%- if vote.par_delegation %}, {{ PAR_DELEGATION_LABEL }}{% endif -%}
    {%- if vote.chambre == "congres" %} ({{ CONGRES_LABEL }}){% endif -%}
  </p>
  {% for declaree in vote.mise_au_point_positions %}
    {# Une mise au point ne modifie jamais le vote enregistré ci-dessus (methodology.md § 3) :
       elle est affichée à côté, jamais fusionnée avec la position. #}
    <p class="vote-item__mise-au-point">
      {{ mise_au_point_label(declaree) }} ({{ MISE_AU_POINT_RESULTAT_INCHANGE }})
    </p>
  {% endfor %}
</li>
{% endmacro %}
