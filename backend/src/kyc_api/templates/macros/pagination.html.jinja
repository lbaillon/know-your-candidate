{% macro pagination(pagination, base_path, extra_qs="") %}
{% if pagination.total_pages > 1 %}
<nav class="pagination" aria-label="Pagination">
  {% if pagination.has_previous %}
    <a href="{{ base_path }}?page={{ pagination.page - 1 }}{{ extra_qs }}">Page précédente</a>
  {% endif %}
  <span class="pagination__status">Page {{ pagination.page }} sur {{ pagination.total_pages }}</span>
  {% if pagination.has_next %}
    <a href="{{ base_path }}?page={{ pagination.page + 1 }}{{ extra_qs }}">Page suivante</a>
  {% endif %}
</nav>
{% endif %}
{% endmacro %}
